{
  "schemaVersion": 1,
  "id": "${mod_id}",
  "version": "${mod_version}+${minecraft_version}",
  "name": "${mod_name}",
  "description": "${mod_description}",
  "authors": [
    "${mod_author}"
  ],
  "contributors": [
    "${fabric_mod_contributors}"
  ],
  "contact": {
    "homepage": "${homepage}",
    "issues": "https://github.com/${sources}/issues",
    "sources": "https://github.com/${sources}"
  },
  "license": "${mod_license}",
  "icon": "assets/${mod_id}/icon.png",
  "environment": "*",
  "entrypoints": {
    "main": [
      "dev.muon.dynamic_difficulty.DynamicDifficultyFabric"
    ],
    "client": [
      "dev.muon.dynamic_difficulty.client.DynamicDifficultyClient"
    ],
    "preLaunch": [
      "dev.muon.dynamic_difficulty.DynamicDifficultyFabricPre"
    ],
    "mixinsquared-adjuster": [
      "dev.muon.dynamic_difficulty.mixin.DDMixinAdjuster"
    ],
    "modmenu": [
      "dev.muon.dynamic_difficulty.compat.modmenu.ModMenuIntegration"
    ],
    "jade": [
      "dev.muon.dynamic_difficulty.compat.jade.JadePlugin"
    ]
  },
  "mixins": [
    "${mod_id}.mixins.json",
    "${mod_id}.fabric.mixins.json"
  ],
  "depends": {
    "fabricloader": "${fabric_loader_range}",
    "fabric-api": "*",
    "minecraft": "${fabric_minecraft_version_range}",
    "java": ">=${java_version}"
  }
}