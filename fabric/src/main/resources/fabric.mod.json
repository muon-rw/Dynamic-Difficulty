{
    "schemaVersion": 1,
    "id": "${mod_id}",
    "version": "${version}",
    "name": "${mod_name}",
    "description": "${description}",
    "authors": [
        "${mod_author}"
    ],
    "contributors": [
        "${credits}"
    ],
    "contact": {
        "homepage": "https://www.curseforge.com/minecraft/mc-mods/dynamic-difficulty-mod",
        "issues": "https://github.com/${github_owner}/${github_repo}/issues",
        "sources": "https://github.com/${github_owner}/${github_repo}"
    },
    "license": "${license}",
    "icon": "${mod_id}.png",
    "environment": "*",
    "entrypoints": {
        "main": [
            "dev.muon.dynamic_difficulty.DynamicDifficultyFabric"
        ],
        "client": [
            "dev.muon.dynamic_difficulty.client.DynamicDifficultyClient"
        ],
        "preLaunch": [
            "dev.muon.dynamic_difficulty.DynamicDifficultyFabricPre"
        ],
        "mixinsquared-adjuster": [
            "dev.muon.dynamic_difficulty.mixin.DDMixinAdjuster"
        ],
        "modmenu": [
            "dev.muon.dynamic_difficulty.compat.modmenu.ModMenuIntegration"
        ],
        "jade": [
            "dev.muon.dynamic_difficulty.compat.jade.JadePlugin"
        ]
    },
    "mixins": [
        "${mod_id}.mixins.json",
        "${mod_id}.fabric.mixins.json"
    ],
    "depends": {
        "fabricloader": ">=${fabric_loader_version}",
        "fabric-api": "*",
        "minecraft": "~${minecraft_version}",
        "java": ">=${java_version}",
        "fzzy_config": "*"
    }
}
